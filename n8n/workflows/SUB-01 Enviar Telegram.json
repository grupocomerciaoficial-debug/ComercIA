    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst w = d.wa || {};\nconst chat = d.mensaje && d.mensaje.wa_id;\nconst fail = (m) => [{ json: { ...d, tipo_invalido: true, error_envio: m } }];\nif (!chat) return fail('sin chat_id de Telegram');\nlet text = w.texto ? String(w.texto) : '';\nlet rows = [];\nif (w.tipo === 'texto') {\n} else if (w.tipo === 'botones') {\n  rows = (w.botones || []).map(b => [{ text: String(b.titulo), callback_data: String(b.id).slice(0, 64) }]);\n} else if (w.tipo === 'lista') {\n  rows = (w.filas || []).map(f => [{ text: String(f.titulo), callback_data: String(f.id).slice(0, 64) }]);\n} else if (w.tipo === 'plantilla') {\n  if (!text && w.plantilla) text = String(w.plantilla) + (w.params ? ': ' + w.params.map(String).join(' ') : '');\n} else {\n  return fail('wa.tipo desconocido: ' + w.tipo);\n}\nif (!text) return fail('sin texto para enviar');\ntext = text.slice(0, 4096);\nconst payload = { chat_id: String(chat), text };\nif (rows.length) payload.reply_markup = { inline_keyboard: rows.map(r => [{ text: r[0].text, callback_data: r[0].callback_data }]) };\nreturn [{ json: { ...d, tipo_invalido: false, payload } }];"
      },
