    {
      "parameters": {
        "jsCode": "const cb = $json.callback_query;\nconst m = cb ? cb.message : $json.message;\n\nif (!m || !m.chat || m.chat.id === undefined) {\n  return [{ json: { es_mensaje: false } }];\n}\n\nlet tipo = 'otro';\n\nif (cb || m.text) {\n  tipo = 'texto';\n} else {\n  for (const k of ['photo', 'voice', 'audio', 'document', 'video', 'sticker', 'location', 'contact']) {\n    if (m[k]) {\n      tipo = k;\n      break;\n    }\n  }\n}\n\nconst texto = cb ? (cb.data || null) : (m.text || m.caption || null);\nconst botones = (m.reply_markup && m.reply_markup.inline_keyboard || []).flat();\nconst etiqueta = cb\n  ? (botones.find(b => b.callback_data === cb.data)?.text || cb.data)\n  : null;\n\nconst nombres = {\n  photo: 'Imagen recibida',\n  voice: 'Nota de voz recibida',\n  audio: 'Audio recibido',\n  document: 'Documento recibido',\n  video: 'Video recibido',\n  sticker: 'Sticker recibido',\n  location: 'Ubicación compartida',\n  contact: 'Contacto compartido'\n};\n\nconst contenido = cb\n  ? (etiqueta || 'Opción seleccionada: ' + (cb.data || ''))\n  : (m.text || m.caption || nombres[tipo] || 'Mensaje recibido');\n\nreturn [{\n  json: {\n    es_mensaje: true,\n    mensaje: {\n      wa_message_id: cb ? String(cb.id) : String(m.message_id),\n      wa_id: String(m.chat.id),\n      tipo,\n      texto,\n      contenido,\n      interactivo: !!cb,\n      ts: String(m.date || '')\n    },\n    comercio: { phone_number_id: $json.bot_id }\n  }\n}];"
      },
