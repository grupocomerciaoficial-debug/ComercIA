      "parameters": {
        "jsCode": "const cb=$json.callback_query;\nconst m=cb?cb.message:$json.message;\nif(!m||!m.chat||m.chat.id===undefined){return [{json:{es_mensaje:false}}];}\nlet tipo='otro';\nif(cb||m.text){tipo='texto';}\nelse{for(const k of ['photo','voice','audio','document','video','sticker','location','contact']){if(m[k]){tipo=k;break;}}}\nconst texto=cb?(cb.data||null):(m.text||m.caption||null);\nreturn [{json:{es_mensaje:true,mensaje:{wa_message_id:cb?String(cb.id):String(m.message_id),wa_id:String(m.chat.id),tipo,texto,interactivo:!!cb,ts:String(m.date||'')},comercio:{phone_number_id:$json.bot_id}}}];"
      },
