      "parameters": {
        "jsCode": "const ctx=$('Configuración').first().json; const a=$input.first().json||{};\nconst t=ctx.mensaje.texto; const horas=a.ultimo_aviso?(Date.now()-new Date(a.ultimo_aviso))/36e5:999;\nlet accion='sin_decision';\nif(ctx.mensaje.interactivo&&t==='ACEPTO')accion='boton_acepto';\nelse if(ctx.mensaje.interactivo&&t==='NO_ACEPTO')accion='boton_no_acepto';\nelse if(a.decision==='acepto'&&a.version_vigente===true)accion='ya_acepto';\nelse if(a.decision==='no_acepto')accion=horas>=Number(ctx.repetir_aviso_horas||24)?'repetir_aviso':'silencio';\nreturn [{json:{...ctx,accion,autorizacion:a}}];"
      },
