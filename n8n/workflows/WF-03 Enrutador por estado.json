    {
      "parameters": {
        "jsCode": "const t=($json.mensaje.texto||'').toLowerCase().trim(); const est=$json.conversacion.estado||'MENU';\nconst saludos=['/start','start','hola','inicio','menu','menú'];\nif($json.reinicio||saludos.includes(t)){\n  // Volver a dar la bienvenida: se envía a WF-04 como opción MENU (reinicia el estado y muestra el menú de bienvenida).\n  return [{json:{...$json,mensaje:{...$json.mensaje,texto:'MENU',texto_original:$json.mensaje.texto},ruta:'consultas'}}];\n}\nlet ruta='consultas';\nif(/(cancelar|modificar|cambiar).*(pedido)|solicitud/.test(t)||est==='SOLICITUD'){ruta='solicitud';}\nelse if(est.startsWith('PEDIDO')){ruta='pedido';}\nreturn [{json:{...$json,ruta}}];"
      },
