    {
      "parameters": {
        "jsCode": "const ctx=$('Entrada').first().json; const conv=$('Cargar conversación').first().json;\n// Reinicio por inactividad: si el mensaje anterior (entrante o saliente) tiene más de MINUTOS_INACTIVIDAD, se vuelve a dar la bienvenida.\nconst MINUTOS_INACTIVIDAD=10;\nconst fechas=$input.all().map(i=>i.json&&i.json.fecha_mensaje).filter(Boolean);\nlet reinicio=false; let horas_inactivo=null;\nif(fechas.length>=2){horas_inactivo=(Date.now()-new Date(fechas[1]).getTime())/3600000; reinicio=(horas_inactivo*60)>=MINUTOS_INACTIVIDAD;}\n// El horario se lee de comercio.horario_atencion (columna del esquema Supabase); si no existe, no se marca fuera de horario.\nconst h=ctx.comercio.horario_atencion||ctx.comercio.horario; let fuera=false;\nif(h&&typeof h==='object'&&Object.keys(h).length){const now=new Date(new Date().toLocaleString('en-US',{timeZone:'America/Bogota'}));\nconst dias=['dom','lun','mar','mie','jue','vie','sab'];const d=h[dias[now.getDay()]];\nconst hm=now.getHours()*60+now.getMinutes();const f=s=>{const [a,b]=String(s).split(':').map(Number);return a*60+b};\nfuera=!d||d.cerrado||hm<f(d.abre)||hm>=f(d.cierra);}\nreturn [{json:{...ctx,conversacion:conv,fuera_horario:fuera,reinicio,horas_inactivo}}];"
      },
