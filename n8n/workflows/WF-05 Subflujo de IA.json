    {
      "parameters": {
        "jsCode": "const r=$input.first().json; const tb=Array.isArray(r.content)?r.content.find(c=>c&&c.type==='text'):null; const t=((tb&&tb.text)||'').replace(/```json|```/g,'').trim();\nconst ok=['hacer_pedido','ver_catalogo','estado_pedido','pregunta_faq','hablar_persona','ajeno','no_entendido'];\ntry{const j=JSON.parse(t); if(!ok.includes(j.intencion)||!Array.isArray(j.items||[]))throw new Error('esquema');\nreturn [{json:{valido:true,intencion:j.intencion,items:(j.items||[]).map(i=>({producto:String(i.producto||''),cantidad:Number(i.cantidad)||0,especificaciones:String(i.especificaciones||'').slice(0,200)})),respuesta:String(j.respuesta||''),encontrada_en_guia:!!j.encontrada_en_guia,confianza:Number(j.confianza)||0}}];\n}catch(e){return [{json:{valido:false,intencion:'no_entendido',items:[],respuesta:'',encontrada_en_guia:false,confianza:0}}];}"
      },
