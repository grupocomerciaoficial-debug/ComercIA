    {
      "parameters": {
        "jsCode": "const d=$input.first().json; const cfg=$('Normalizar entrada').first().json;\nif(!d.pedido||!d.comercio||!d.cliente){return [{json:{historial_id:cfg.historial_id,avisar:false,motivo:'sin_datos'}}];}\nconst e=String(d.pedido.estado_nuevo||'').toLowerCase(); const modo=String(d.comercio.modo_seguimiento||'').toLowerCase();\nlet avisar=false,texto='',plantilla=null;\nif(e==='confirmado'){avisar=true;texto='Tu pedido #'+d.pedido.numero+' fue confirmado.\\n'+d.pedido.resumen+'\\nEntrega: '+d.pedido.entrega_detalle+'\\nTiempo estimado: '+d.comercio.tiempo_preparacion;plantilla='pedido_confirmado';}\nelse if(e==='cancelado'){avisar=true;texto='Tu pedido #'+d.pedido.numero+' fue cancelado.'+(d.pedido.motivo?' Motivo: '+d.pedido.motivo:'');plantilla='pedido_cancelado';}\nelse if(e==='procesado'&&modo==='completo'){avisar=true;texto='Tu pedido #'+d.pedido.numero+' está en proceso.';plantilla='pedido_procesado';}\nreturn [{json:{...d,historial_id:cfg.historial_id,avisar,texto,plantilla,tiene_chat:!!d.cliente.wa_id}}];"
      },
