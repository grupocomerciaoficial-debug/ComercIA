      "parameters": {
        "jsCode": "var e = $input.first().json;\nvar wf = e.workflow || {};\nvar ex = e.execution || {};\nvar er = ex.error || {};\nvar nombre = wf.name || '';\nvar lista = e.workflows_cliente || [];\nvar esCliente = false;\nfor (var i = 0; i < lista.length; i++) {\n  if (lista[i] === nombre) { esCliente = true; }\n}\nreturn [{ json: {\n  workflow: nombre,\n  workflow_id: wf.id || null,\n  nodo: ex.lastNodeExecuted || '',\n  mensaje_error: er.message || '',\n  execution_id: ex.id || null,\n  execution_url: ex.url || null,\n  comercio_id: e.comercio_id,\n  phone_number_id: e.phone_number_id,\n  es_flujo_cliente: esCliente\n} }];"
